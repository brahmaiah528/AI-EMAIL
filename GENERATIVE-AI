        "from transformers import AutoTokenizer\n",
        "\n",
        "# Load BERT and GPT-2 tokenizers\n",
        "bert_tokenizer = AutoTokenizer.from_pretrained(\n",
        "    \"bert-base-uncased\"\n",
        ")\n",
        "\n",
        "gpt_tokenizer = AutoTokenizer.from_pretrained(\n",
        "    \"gpt2\"\n",
        ")\n",
        "\n",
        "text = \"Generative AI is transforming education.\"\n",
        "\n",
        "# Tokenize using BERT\n",
        "bert_tokens = bert_tokenizer.tokenize(text)\n",
        "bert_ids = bert_tokenizer.encode(text)\n",
        "\n",
        "# Tokenize using GPT-2\n",
        "gpt_tokens = gpt_tokenizer.tokenize(text)\n",
        "gpt_ids = gpt_tokenizer.encode(text)\n",
        "\n",
        "print(\"Input text:\", text)\n",
        "\n",
        "print(\"\\nBERT tokens:\")\n",
        "print(bert_tokens)\n",
        "print(\"BERT token IDs:\")\n",
        "print(bert_ids)\n",
        "\n",
        "print(\"\\nGPT-2 tokens:\")\n",
        "print(gpt_tokens)\n",
        "print(\"GPT-2 token IDs:\")\n",
        "print(gpt_ids)\n",
        "\n",
        "print(\"\\nBERT token count:\", len(bert_ids))\n",
        "print(\"GPT-2 token count:\", len(gpt_ids))"
      ],
